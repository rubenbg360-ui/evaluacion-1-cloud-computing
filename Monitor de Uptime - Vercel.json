      "typeVersion": 4.2,
      "position": [
        224,
        128
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "chatId": "<__PLACEHOLDER_VALUE__ID del chat de Telegram para las alertas__>",
        "text": "=¡Alerta de Caída! El servidor de Cloud Computing no responde.\nURL: https://mi-app-despliegue-vercel.app\nCódigo: {{ $json.statusCode || \"sin respuesta\" }}\nHora: {{ $now.toFormat(\"yyyy-MM-dd HH:mm\") }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "884ced57-ed08-4160-864c-5140e2b7acdd",
